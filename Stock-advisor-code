def check_tax_loss_harvesting(quotes):
portfolio    = load_portfolio()
candidates   = []
for ticker, pos in portfolio[“positions”].items():
q = next((x for x in quotes if x[“ticker”] == ticker), None)
if q:
cost_basis = pos[“shares”] * pos[“avg_price”]
cur_val    = pos[“shares”] * q[“current_price”]
loss       = cur_val - cost_basis
if loss < 0 and abs(loss / cost_basis) > 0.10:
candidates.append({
“ticker”: ticker, “shares”: pos[“shares”],
“avg_price”: pos[“avg_price”], “current_price”: q[“current_price”],
“unrealized_loss”: round(loss,2),
“loss_pct”: round((loss / cost_basis)*100, 2)
})
return candidates

