def get_stock_quote(ticker):
try:
quote = finnhub_client.quote(ticker)
if quote[“pc”] == 0:
return None
return {
“ticker”: ticker,
“current_price”: quote[“c”],
“high”: quote[“h”],
“low”: quote[“l”],
“open”: quote[“o”],
“prev_close”: quote[“pc”],
“change_percent”: round(((quote[“c”] - quote[“pc”]) / quote[“pc”]) * 100, 2)
}
except Exception as e:
print(f”  ⚠️  Error fetching {ticker}: {e}”)
return None

