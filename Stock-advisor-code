def add_position(ticker, shares, price):
portfolio = load_portfolio()
cost = shares * price
if cost > portfolio[“cash”]:
print(f”❌ Insufficient funds. Available: ${portfolio[‘cash’]:.2f}, Needed: ${cost:.2f}”)
return False
if ticker in portfolio[“positions”]:
ex     = portfolio[“positions”][ticker]
total  = ex[“shares”] + shares
avg    = ((ex[“shares”] * ex[“avg_price”]) + cost) / total
portfolio[“positions”][ticker] = {“shares”: total, “avg_price”: avg, “date_added”: ex[“date_added”]}
else:
portfolio[“positions”][ticker] = {“shares”: shares, “avg_price”: price, “date_added”: datetime.now().strftime(”%Y-%m-%d”)}
portfolio[“cash”]           -= cost
portfolio[“total_invested”] += cost
portfolio[“history”].append({“action”:“BUY”,“ticker”:ticker,“shares”:shares,“price”:price,“date”:datetime.now().strftime(”%Y-%m-%d %H:%M”)})
save_portfolio(portfolio)
print(f”✅ Bought {shares} shares of {ticker} at ${price}”)
return True

def remove_position(ticker, shares, price):
portfolio = load_portfolio()
if ticker not in portfolio[“positions”]:
print(f”❌ {ticker} not in portfolio”)
return False
proceeds = shares * price
portfolio[“cash”] += proceeds
if shares >= portfolio[“positions”][ticker][“shares”]:
del portfolio[“positions”][ticker]
else:
portfolio[“positions”][ticker][“shares”] -= shares
portfolio[“history”].append({“action”:“SELL”,“ticker”:ticker,“shares”:shares,“price”:price,“date”:datetime.now().strftime(”%Y-%m-%d %H:%M”)})
save_portfolio(portfolio)
print(f”✅ Sold {shares} shares of {ticker} at ${price}”)
return True

def get_portfolio_value(quotes):
portfolio   = load_portfolio()
total_value = portfolio[“cash”]
positions   = []
for ticker, pos in portfolio[“positions”].items():
q = next((x for x in quotes if x[“ticker”] == ticker), None)
if q:
cur_val    = pos[“shares”] * q[“current_price”]
cost_basis = pos[“shares”] * pos[“avg_price”]
gl         = cur_val - cost_basis
gl_pct     = (gl / cost_basis) * 100
total_value += cur_val
positions.append({
“ticker”: ticker, “shares”: pos[“shares”],
“avg_price”: pos[“avg_price”], “current_price”: q[“current_price”],
“current_value”: round(cur_val,2), “gain_loss”: round(gl,2),
“gain_loss_pct”: round(gl_pct,2)
})
return {
“total_value”:       round(total_value, 2),
“cash”:              round(portfolio[“cash”], 2),
“starting_capital”:  STARTING_CAPITAL,
“total_return”:      round(total_value - STARTING_CAPITAL, 2),
“total_return_pct”:  round(((total_value - STARTING_CAPITAL) / STARTING_CAPITAL) * 100, 2),
“positions”:         positions
}

