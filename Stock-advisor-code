def what_if_simulator():
log = load_learning_log()
if not log:
return {“message”: “No suggestion history yet. Check back after a few days!”, “simulated_value”: STARTING_CAPITAL, “simulated_return_pct”: 0}
simulated = STARTING_CAPITAL
trades    = []
for entry in log:
for pick in entry.get(“picks_performance”, []):
if pick.get(“actual_return”):
trade_val = simulated * 0.1
gain      = trade_val * (pick[“actual_return”] / 100)
simulated += gain
trades.append({“ticker”: pick.get(“ticker”,“N/A”), “return”: pick[“actual_return”], “gain_loss”: round(gain,2)})
return {
“starting_capital”:      STARTING_CAPITAL,
“simulated_value”:       round(simulated, 2),
“simulated_return_pct”:  round(((simulated - STARTING_CAPITAL) / STARTING_CAPITAL) * 100, 2),
“total_trades”:          len(trades),
“trades”:                trades[-10:]
}

